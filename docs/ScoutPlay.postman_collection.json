              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"atletaId\": \"{{atletaId}}\",\n  \"nota\": 7.0,\n  \"comentario\": \"Atleta avaliando a si mesmo — deve ser bloqueado.\"\n}"
            },
            "url": "{{baseUrl}}/api/avaliacoes",
            "description": "⚠️ Faça login como ATLETA antes. Deve retornar 403 Forbidden."
          }
        },
        {
          "name": "Listar avaliações do atleta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tem content', () => pm.expect(pm.response.json().data.content).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/atletas/{{atletaId}}/avaliacoes?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "atletas", "{{atletaId}}", "avaliacoes"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "🖼️ Fotos",
      "item": [
        {
          "name": "Upload de foto (multipart)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tem fotoPerfil', () => pm.expect(pm.response.json().data.fotoPerfil).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Selecione um arquivo JPG ou PNG (máx 10MB)"
                }
              ]
            },
            "url": "{{baseUrl}}/api/atletas/{{atletaId}}/foto",
            "description": "Selecione um arquivo JPG ou PNG no campo 'file'.\nToken deve ser do próprio atleta."
          }
        },
        {
          "name": "Servir foto (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 ou 404', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/atletas/fotos/NOME_DO_ARQUIVO.jpg",
            "description": "Substitua NOME_DO_ARQUIVO.jpg pelo valor retornado no upload.\nEste endpoint é público, não precisa de token."
          }
        }
      ]
    }
  ]
}
