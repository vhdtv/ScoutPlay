{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Subir Back-End",
            "request": "launch",
            "mainClass": "com.scoutplay.ScoutPlay.ScoutPlayApplication",
            "projectName": "ScoutPlay",
            "cwd": "${workspaceFolder}/back-end",
            "args": ["--my-app-argument"],
            "vmArgs": ["-Dmy.system.property=true"]
        },
        {
            "type": "node",
            "name": "Subir Front-End",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}/front-end",
        }
    ],
    "compounds": [
        {
            "name": "Rodar Aplicação (DEV)",
            "configurations": [
                "Subir Back-End",
                "Subir Front-End"
            ]
        }
    ]
}